@@ -14,6 +14,7 @@
 #include <errno.h>
 #include <gbm.h>
 #include <glib-unix.h>
+#include <string.h>
 #include <wayland-util.h>
 #include <wpe/fdo-egl.h>
 #include <wpe/fdo.h>
@@ -282,7 +283,24 @@ cog_drm_gles_renderer_initialize(CogDrmRenderer *renderer, GError **error)
         return false;
